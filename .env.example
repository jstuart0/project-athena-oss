# ============================================================================
# Project Athena Configuration
# ============================================================================
# Copy this file to .env and configure for your installation.
#
# LEGEND:
#   REQUIRED - Service will fail to start without this
#   RECOMMENDED - Has default but should be changed for production
#   OPTIONAL - Has sensible default, change if needed
#
# AthenaConfig — centralized env-var object
# ------------------------------------------
# Variables marked below are automatically mapped to typed fields on the
# AthenaConfig class defined in src/shared/config.py.  In any service that
# imports from the shared package, read these values via:
#
#   from shared.config import get_config
#   cfg = get_config()
#   cfg.ollama_url   # instead of os.getenv("OLLAMA_URL")
#
# The singleton is cached per-process (lru_cache) so the cost of
# environment-variable resolution is paid exactly once.  See CONTRIBUTING.md
# for the extension pattern when adding new variables.
# ============================================================================

# ============================================================================
# REQUIRED - No defaults, services fail fast if missing
# ============================================================================

# Database password - MUST be set
# Generate: openssl rand -base64 24 | tr -d '/+='
ATHENA_DB_PASSWORD=

# ============================================================================
# Admin Backend URL — REQUIRED
# ============================================================================
# Resolution order (handled by src/shared/admin_url.py):
#   1. ADMIN_API_URL              (canonical primary — set this one)
#   2. ADMIN_BACKEND_URL          (alias, accepted for backward compatibility)
#   3. ADMIN_INTERNAL_URL         (DEPRECATED alias — will be removed in a future release)
#   4. LOCAL_DEV=true             → http://localhost:8080  (local-dev escape hatch)
#   5. K8s in-cluster auto-discovery (when KUBERNETES_SERVICE_HOST is set) → http://athena-admin-backend:8080
#   6. (empty + warning)          → callers will receive connection errors
#
# Docker:             http://admin-backend:8080
# Kubernetes:         http://athena-admin-backend:8080
# Local development:  set LOCAL_DEV=true OR set ADMIN_API_URL=http://localhost:8080
ADMIN_API_URL=

# Security keys for admin backend - MUST be unique per installation
# Generate each: openssl rand -base64 32
# SESSION_SECRET_KEY/JWT_SECRET must be plain random strings, not a
# copy-pasted key file - a PEM header or SSH key-type substring makes
# JWT minting and validation both fail with a 500.
ENCRYPTION_KEY=
SESSION_SECRET_KEY=
JWT_SECRET=

# Encryption salt for API key storage
# Generate: openssl rand -base64 16
ENCRYPTION_SALT=

# Service-to-service authentication (admin backend ↔ orchestrator/gateway/RAG services)
# All internal callers must send this as the X-Service-Key header.
# Generate: openssl rand -base64 32
# REQUIRED in production (DEV_MODE=false). Empty value or "dev-service-key-change-in-production" placeholder in production halts startup with SystemExit. See CLAUDE.md "Admin-backend startup gates" and ATHENA-21.
SERVICE_API_KEY=

# ORCHESTRATOR_INGRESS_AUTH (D10) — gates the orchestrator's query and
# session routes behind X-Service-Key. "enforce" (default) requires a valid
# key; a wrong key is always 401, even in DEV_MODE. "warn" logs
# orchestrator_unauthenticated_request and allows the request through --
# use this temporarily to find any caller a header rollout missed, before
# switching back to enforce. Any other value behaves as "enforce" and logs
# an ERROR (invalid config, not a silent fallback).
# ORCHESTRATOR_INGRESS_AUTH=enforce

# ----------------------------------------------------------------------------
# Mode and permissions (ATHENA-69) — see docs/CONFIGURATION.md
# "Mode and permissions" for the full model.
# ----------------------------------------------------------------------------

# MODE_SERVICE_INGRESS_AUTH — same three-value contract as
# ORCHESTRATOR_INGRESS_AUTH above, applied to the mode service's /mode*
# routes. "enforce" (default) requires X-Service-Key; "warn" logs
# mode_service_ingress_auth_warn_active (at startup and hourly while
# active) and allows the request through -- use temporarily during a
# staged rollout. Any other value behaves as "enforce" and logs an ERROR.
# MODE_SERVICE_INGRESS_AUTH=enforce

# LIVEKIT_USER_TOKEN_TTL_MINUTES — TTL for browser-facing LiveKit room
# tokens (jarvis-web voice sessions). Clamped 1-1440. Server-side Athena
# participant tokens are unaffected (explicit 24h TTL). Default 30.
# LIVEKIT_USER_TOKEN_TTL_MINUTES=30

# Guest permission baselines and the mode-service-outage fallback
# (D4/D8/D22). Each accepts a JSON array; unset or malformed falls back to
# the built-in default list (never an empty list, which would silently
# disable a floor); an explicit "[]" is honoured as an intentional
# deployer opt-out and is logged once at startup
# (ha_permission_fallback_disabled).
#
# HA_PERMISSION_FALLBACK_RESTRICTED_ENTITIES — entity-id regex patterns
# applied when the mode service is unreachable or rejecting (the
# "degraded" permission set). Default restricts locks, covers, alarm
# panels, cameras, automations, scripts, and scenes; lights/climate/media
# stay usable.
# HA_PERMISSION_FALLBACK_RESTRICTED_ENTITIES=[]
#
# GUEST_BASELINE_RESTRICTED_ENTITIES — the floor unioned into every
# guest's restricted_entities regardless of admin config; same domain set
# as the fallback list above, always unioned in, never replaced.
# GUEST_BASELINE_RESTRICTED_ENTITIES=[]
#
# GUEST_BASELINE_ALLOWED_INTENTS / GUEST_BASELINE_ALLOWED_DOMAINS — used
# only when the admin-configured guest allowlist is empty; an empty admin
# list means "use this baseline", never "allow everything".
# GUEST_BASELINE_ALLOWED_INTENTS=["weather","time","general_info","news","recipes","streaming"]
# GUEST_BASELINE_ALLOWED_DOMAINS=["light","media_player","switch","climate"]
#
# MODE_OVERRIDE_LOCKOUT_THRESHOLD / MODE_OVERRIDE_LOCKOUT_MINUTES — read by
# the admin backend's per-tier owner-PIN lockout counter (POST
# /api/internal/guest-mode/verify-pin): after this many failed
# verifications in a trust tier within the lockout window, that tier is
# locked out for this many minutes. Defaults 5 and 30.
# MODE_OVERRIDE_LOCKOUT_THRESHOLD=5
# MODE_OVERRIDE_LOCKOUT_MINUTES=30

# HA_WRITE_FANOUT_CONFIRM_THRESHOLD / HA_WRITE_FANOUT_HARD_LIMIT -- bound how
# many distinct Home Assistant entities one utterance may write without
# naming that scope ("turn off all the office lights"). Above the
# threshold, a non-command phrasing gets a confirmation ("Should I go
# ahead?") on surfaces that carry a follow-up, or the exact wording to
# repeat on those that don't. A plain command ("turn off the office
# lights") is only stopped above the hard limit. 0 disables either check.
# Every service that loads the shared config reads these; a hard limit
# below the threshold (other than 0) logs an ERROR and both fall back to
# the defaults.
# HA_WRITE_FANOUT_CONFIRM_THRESHOLD=6
# HA_WRITE_FANOUT_HARD_LIMIT=18

# OVERRIDE_MAX_TIMEOUT_MINUTES (ATHENA-69 Pass H2) — server-side ceiling on
# POST /mode/override's timeout_minutes, applied regardless of PIN outcome.
# A requested value above this is clamped, never rejected. Default 240.
# OVERRIDE_MAX_TIMEOUT_MINUTES=240

# jarvis-web home network (jarvis-web only). With none of these set, every
# browser gets 401 (sign-in required): jarvis-web serves without sign-in
# only to the home network, and to signed-in users via an auth proxy.
# See docs/CONFIGURATION.md, "jarvis-web: who may use it".
#   Behind a reverse proxy: TRUSTED_PROXY_CIDRS (the proxy's addresses),
#   the home CIDRs, and the host names browsers use.
# JARVIS_LOCAL_NETWORKS=192.0.2.0/24
# JARVIS_GUEST_NETWORKS=198.51.100.0/24
# JARVIS_LOCAL_EXCLUDE=192.0.2.14/32
# JARVIS_ALLOWED_HOSTS=jarvis.example.com
#   Browsers reaching jarvis-web directly (no proxy, source preserved):
# JARVIS_DIRECT_CLIENTS=true
# (The old household switch for this is removed; setting it to
#  "household" now stops jarvis-web at startup.)
#   Sign-in from the internet through an auth proxy (edge mode; see
#   manifests/athena-prod/optional/jarvis-web-edge-auth.yaml). Secrets come
#   from a Secret, never from this file in production:
# JARVIS_EDGE_ATTESTATION_SECRET=<at least 32 random characters>
# JARVIS_HOUSEHOLD_GROUPS=household
# JARVIS_SIGNIN_URL=https://jarvis-signin.example.com/
# JARVIS_LOGIN_URL=https://jarvis.example.com/
# JARVIS_LOGOUT_URL=https://auth.example.com/if/flow/default-invalidation-flow/
#   Edge mode with no home network at all (everyone signs in); without it,
#   edge mode needs TRUSTED_PROXY_CIDRS, JARVIS_LOCAL_NETWORKS and
#   JARVIS_ALLOWED_HOSTS or jarvis-web won't start:
# JARVIS_EDGE_SIGN_IN_ONLY=false
#   The signed-in member's display name (first word only is used; never
#   logged). Default X-authentik-name:
# JARVIS_EDGE_NAME_HEADER=X-authentik-name
#   Only after adding a custom JARVIS_EDGE_IDENTITY_HEADER/_GROUPS_HEADER/
#   _NAME_HEADER name to the edge's strip Middleware; list exactly those names:
# JARVIS_EDGE_HEADERS_ACK_STRIPPED=X-Remote-User,X-Remote-Groups
#   Push-to-talk budget per client, and the longest text to speak:
# JARVIS_VOICE_REQUESTS_PER_MINUTE=30
# JARVIS_TTS_MAX_CHARS=5000
#   Website chatbot (chat-embed) relay; the same value on chat-embed:
# JARVIS_RELAY_KEY=<at least 32 random characters>
#   Browsers on other origins (exact origins; "*" is refused):
# JARVIS_CORS_ORIGINS=
#   Rate limits read Cf-Connecting-Ip only behind a fully trusted
#   Cloudflare tunnel (never for the home rule):
# TRUST_CF_CONNECTING_IP=false
#   The API docs (/docs, /redoc, /openapi.json); development only:
# JARVIS_ENABLE_DOCS=false

# ============================================================================
# RECOMMENDED - Has defaults but review for production
# ============================================================================

# Database connection (password still REQUIRED above)
ATHENA_DB_HOST=localhost
ATHENA_DB_PORT=5432
ATHENA_DB_NAME=athena
ATHENA_DB_USER=athena

# Admin database (defaults to main database host with _admin suffix)
# Both ATHENA_ADMIN_DB_* and ADMIN_DB_* are accepted aliases.
# ATHENA_ADMIN_DB_HOST=${ATHENA_DB_HOST}
# ATHENA_ADMIN_DB_PORT=${ATHENA_DB_PORT}
# ATHENA_ADMIN_DB_NAME=athena_admin
# ATHENA_ADMIN_DB_USER=${ATHENA_DB_USER}
# ADMIN_DB_HOST=${ATHENA_DB_HOST}
# ADMIN_DB_PORT=${ATHENA_DB_PORT}
# ADMIN_DB_NAME=athena_admin
# ADMIN_DB_USER=${ATHENA_DB_USER}

# SQLAlchemy / Alembic direct DSN (overrides individual ATHENA_DB_* vars).
# Useful for migrations or connecting to a managed Postgres.
# DATABASE_URL=postgresql://athena:password@localhost:5432/athena

# ============================================================================
# OPTIONAL - Sensible defaults for development
# ============================================================================

# ----------------------------------------------------------------------------
# Infrastructure Services
# ----------------------------------------------------------------------------

# Ollama LLM Server (default: localhost:11434)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
# Or specify full URL (overrides host/port):
# OLLAMA_URL=http://ollama:11434
# Or use legacy env var:
# LLM_SERVICE_URL=http://ollama:11434
#
# In-cluster Ollama (a K8s Service, e.g. http://ollama:11434) needs its
# hostname or ClusterIP CIDR added to HEALTH_POLL_ALLOWED_PRIVATE_HOSTS
# below, same as any other in-cluster Service -- otherwise every runtime
# probe (model discovery, voice tests, service-control) refuses with
# ssrf_blocked. Bare-metal localhost dev (this default) works out of the
# box without that allowlist entry: the Ollama SSRF gate carves out
# loopback/RFC1918/ULA hosts automatically when NOT running inside a K8s
# pod. See docs/CONFIGURATION.md "Ollama (LLM)" for the full rule.

# Qdrant Vector Database (default: localhost:6333)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Or specify full URL:
# QDRANT_URL=http://qdrant:6333

# Redis Cache (default: localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
# Or specify full URL:
# REDIS_URL=redis://redis:6379/0
# Local development: set REDIS_URL=redis://localhost:6379 (the AthenaConfig default
# redis://redis:6379/0 targets in-cluster DNS — you will see connect-refused locally
# unless you set this or run Redis on the "redis" hostname). Round-2 R2-H4.

# Music Assistant (optional). Empty (default) means Music Assistant isn't
# configured; the browser-playback endpoint returns "not configured" instead
# of guessing a host. The admin-stored MusicConfig.music_assistant_url column
# takes precedence over this env default when set.
# MUSIC_ASSISTANT_URL=http://music-assistant.local:8095

# SearXNG (optional, self-hosted search). Empty (default) = SearXNG provider
# disabled — the admin status reads "not configured" with no network probe.
# SEARXNG_BASE_URL=http://searxng.example.com

# ----------------------------------------------------------------------------
# Service Ports
# ----------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8001

ADMIN_PORT=8080

# ----------------------------------------------------------------------------
# Personalization (all optional, leave blank for no defaults)
# ----------------------------------------------------------------------------
DEFAULT_CITY=
DEFAULT_STATE=
DEFAULT_COUNTRY=US
# The property's IANA zone (e.g. America/New_York): the assistant's clock,
# "today" and date windows. The process TZ is not used for these.
DEFAULT_TIMEZONE=UTC

# Default Amtrak station code (3-letter code, e.g. DEN for Denver). Empty
# means callers must specify an origin explicitly on every request.
# DEFAULT_AMTRAK_STATION=

# ----------------------------------------------------------------------------
# Module Enables
# ----------------------------------------------------------------------------
# All modules default to enabled for backwards compatibility.
# Set to "false" to disable.

MODULE_HOME_ASSISTANT=true
MODULE_GUEST_MODE=true
MODULE_NOTIFICATIONS=true
MODULE_JARVIS_WEB=true    # Browser-based voice interface
MODULE_MONITORING=false   # Default off - requires Prometheus/Grafana setup

# ----------------------------------------------------------------------------
# Module Service URLs (for service discovery)
# ----------------------------------------------------------------------------
# Override these if services are on different hosts or use DNS names
# MODE_SERVICE_URL=http://mode-service:8022
# MODE_SERVICE_PORT=8022
# Mode service booking source: auto (admin required, legacy calendar_url
# iCal advisory) | admin | ical. See docs/CONFIGURATION.md.
# MODE_BOOKINGS_SOURCE=auto
# Seconds a source's last successful fetch is trusted before it's expired.
# MODE_BOOKINGS_MAX_AGE_SECONDS=21600
# NOTIFICATIONS_SERVICE_URL=http://notifications:8050
# JARVIS_WEB_URL=http://jarvis-web:3001
# Used by smart_home_controller.py for appliance/sensor/media lookups.
# Empty (default) skips those lookups entirely -- each site takes its
# existing error/unavailable branch rather than dereferencing a
# hardcoded, unreachable-in-cluster host.
# PROMETHEUS_URL=http://prometheus:9090
# GRAFANA_URL=http://grafana:3000

# Internal service-to-service URLs (defaults are localhost — override for Docker/K8s)
# ADMIN_BACKEND_URL=http://localhost:8080
# ADMIN_INTERNAL_URL=  # DEPRECATED: use ADMIN_API_URL. Kept as backward-compat alias only; will be removed in a future release.
# ATHENA_ADMIN_URL=http://localhost:8080
# ATHENA_CHAT_URL=http://localhost:3000
# Control Agent (optional — host-running subprocess controller for Ollama / launchd / docker)
# Set CONTROL_AGENT_ENABLED=true only if you run a Control Agent on a host alongside Ollama.
# Leave false (default) for pure-K8s deployments where no Control Agent is running.
CONTROL_AGENT_ENABLED=false
#
# CONTROL_AGENT_URL — the URL admin-backend uses to reach the CA.
# The CA itself also reads this to derive its own advertised hostname when
# registering services into the admin-backend registry (Phase 3 startup-upsert).
# MUST be the CA's externally-reachable address from both admin-backend's pod
# AND the CA process itself (same value for both callers).
# Example: CONTROL_AGENT_URL=http://192.0.2.10:8099
# Do NOT use 'localhost' here — it would register all services as localhost
# from inside the admin-backend pod, silently poisoning the registry.
# CONTROL_AGENT_URL=http://<control-agent-host-ip>:8099
#
# CONTROL_AGENT_CALLBACK_BASE_URL — where the Control Agent's host reaches
# admin-backend (scheme://host[:port], no path). admin-backend hands it to the
# CA as the base of the model-download progress callback, and the CA sends its
# SERVICE_API_KEY there only when that hostname is an exact entry of the CA
# host's ALLOWED_CALLBACK_HOSTS (below). Empty (default): admin-backend falls
# back to http://localhost:8080 and logs a warning, which only works when the
# CA runs on the same host as admin-backend.
# Example: CONTROL_AGENT_CALLBACK_BASE_URL=https://athena.example.com
# CONTROL_AGENT_CALLBACK_BASE_URL=
#
# Service Control on Kubernetes (opt-in, separate from the Control Agent
# above) — scale RAG/core Deployments directly via the k8s scale
# subresource. Requires manifests/athena-prod/optional/admin-backend-rbac.yaml
# and its automount patch applied first. See docs/CONFIGURATION.md §
# Service Control on Kubernetes.
SERVICE_CONTROL_K8S_ENABLED=false
#
# --- Control Agent .env (on the Control Agent host) ---
# The CA process reads these env vars from its own .env file (not the K8s ConfigMap):
#
#   ADMIN_API_URL=https://<athena-domain>
#     Traefik external URL — NOT cluster-internal DNS (e.g., http://athena-admin-backend:8080).
#     The CA runs off-cluster on a bare host and cannot resolve K8s service DNS.
#     Example: https://athena.example.com
#
#   SERVICE_API_KEY=<value>
#     Shared service-to-service secret.  Retrieve from the K8s secret:
#       kubectl -n athena-prod get secret athena-encryption \
#         -o jsonpath='{.data.SERVICE_API_KEY}' | base64 -d
#     Store in the CA's .env file with 0600 permissions (never in launchd plist).
#
#   CONTROL_AGENT_URL=http://<control-agent-host-ip>:8099
#     Same value as the CONTROL_AGENT_URL set in the K8s ConfigMap above.
#     The CA uses urlparse(CONTROL_AGENT_URL).hostname to derive the host it
#     advertises when POSTing service entries to admin-backend's registry.
#
# All three env vars must be set for Phase 3 startup-upsert to function.
# Missing any one causes the upsert to be skipped with a critical log entry;
# the watchdog and all other CA endpoints continue to operate normally.
#
# Comma-separated list of hostnames the Control Agent is allowed to POST
# HuggingFace download-progress callbacks to.  MUST be set for model downloads
# to function; defaults to empty (fail-closed).  Set to your admin-backend
# hostname as the CA reaches it (the hostname of CONTROL_AGENT_CALLBACK_BASE_URL).
# The CA attaches SERVICE_API_KEY to a callback only when the callback's
# hostname is exactly an entry here; list localhost only when admin-backend
# runs on the CA's own host.  Example (K8s in-cluster):
#   ALLOWED_CALLBACK_HOSTS=athena-admin-backend.athena-prod.svc.cluster.local
# Example (local dev):
#   ALLOWED_CALLBACK_HOSTS=localhost
ALLOWED_CALLBACK_HOSTS=
#
# FRONTEND_URL=http://localhost:8080
# GATEWAY_URL=http://localhost:8000
# ORCHESTRATOR_URL=http://localhost:8001
# ORCHESTRATOR_SERVICE_URL=http://localhost:8001
# VOICE_API_URL=http://localhost:10201
# VOICE_CONTROL_URL=http://localhost:8098

# Health check cache TTL (seconds)
MODULE_HEALTH_CACHE_TTL=30

# ----------------------------------------------------------------------------
# Background Health Poller (ATHENA-1 Phase 4)
# ----------------------------------------------------------------------------
# The admin-backend runs a background task that polls each enabled RAG
# service's /health endpoint on a schedule and caches results in the DB.
# The admin UI reads the cache rather than inline-pinging on every request.
#
# HEALTH_POLL_INTERVAL_SECONDS — seconds between full poll cycles. Default 30.
# HEALTH_POLL_INTERVAL_SECONDS=30
#
# HEALTH_POLL_TIMEOUT_SECONDS — per-request HTTP timeout in seconds. Default 5.
# HEALTH_POLL_TIMEOUT_SECONDS=5
#
# HEALTH_POLL_CONCURRENCY — max simultaneous outbound health pings per cycle.
# Default 8 (asyncio.Semaphore).
# HEALTH_POLL_CONCURRENCY=8
#
# HEALTH_POLL_ALLOWED_PRIVATE_HOSTS — comma-separated CIDRs or hostnames that
# override the RFC1918/loopback/ULA block. Default empty = fail-closed (OSS
# deployers with public-internet services don't need this).
#
# Note: HEALTH_POLL_ALLOW_LOOPBACK was removed in Phase 4 reconcile (ATHENA-1)
# because it was never consumed by the SSRF guard — it was a silent no-op.
# To allow loopback in local-dev, add 127.0.0.0/8 to this list instead:
#   HEALTH_POLL_ALLOWED_PRIVATE_HOSTS=127.0.0.0/8
#
# K8s operators whose services are on private subnets MUST set this to the
# pod CIDR + service CIDR so the poller can reach in-cluster /health endpoints.
#
# Standard K8s example (kubeadm/flannel defaults):
#   HEALTH_POLL_ALLOWED_PRIVATE_HOSTS=10.96.0.0/12,10.244.0.0/16
#
# Example with a host subnet (pod CIDR + service CIDR + host subnet):
#   HEALTH_POLL_ALLOWED_PRIVATE_HOSTS=10.96.0.0/12,10.244.0.0/16,192.0.2.0/24
#
# HEALTH_POLL_ALLOWED_PRIVATE_HOSTS=

# ----------------------------------------------------------------------------
# OpenAI-compatible session lifecycle (ATHENA-88)
# ----------------------------------------------------------------------------
# Bounds on per-conversation OpenAI sessions (/v1/chat/completions,
# /v1/responses) — see docs/CONFIGURATION.md for the full design.
#
# SESSION_MAX_COUNT — cap on concurrent per-conversation sessions (memory
# fallback dict + Redis creation-time index). Oldest is evicted once
# exceeded. Default 5000.
# SESSION_MAX_COUNT=5000
#
# NEW_CONVERSATION_PER_MINUTE_PER_IP — gateway-side sliding-window limit on
# *new* conversations (first-turn requests with no explicit session_id) per
# rate-limit key (see TRUSTED_PROXY_CIDRS below). Default 120 -- raised from
# an earlier default of 30 because behind a reverse proxy every caller can
# share one resolved key, making a low per-source limit a whole-house limit.
# NEW_CONVERSATION_PER_MINUTE_PER_IP=120
#
# TRUSTED_PROXY_CIDRS — comma-separated CIDRs/hosts. The gateway's
# new-conversation limiter trusts X-Forwarded-For's original-client address
# only when the immediate TCP peer (e.g. your reverse proxy's pod IP) falls
# inside one of these ranges; an untrusted caller's own X-Forwarded-For
# header is ignored, so it can't spoof another source's rate-limit key.
# The resolver parses the header right-to-left and returns the nearest hop
# NOT inside this CIDR set (falling back to the TCP peer if every hop is
# trusted) -- this survives a trusted proxy that appends its observed peer
# without stripping whatever the caller already sent, but it is still only
# as strong as this CIDR list: keep it scoped to your actual reverse-proxy
# pod/service subnet, not a broad cluster-wide default, and prefer a
# reverse proxy (Traefik, nginx-ingress) that overwrites X-Forwarded-For
# rather than appending to a caller-supplied value.
# Empty (default) means every caller's peer address is used directly --
# correct for no reverse proxy in front of the gateway, but a shared limiter
# bucket for everyone behind one (the gateway logs trusted_proxy_cidrs_unset
# once at startup as a nudge to set this).
# Example for a flannel/kubeadm-default cluster's pod CIDR:
# TRUSTED_PROXY_CIDRS=10.244.0.0/16
#
# NEW_CONVERSATION_RESET_GRACE_SECONDS — a first-turn fingerprint reset is
# skipped when a session under the same fingerprint was created within this
# many seconds (protects against HA's truncated-ASR retry resending the
# same single-user-message opener for the same turn). Default 120.
# NEW_CONVERSATION_RESET_GRACE_SECONDS=120
#
# The new-conversation limiter's counters are backed by Redis (REDIS_URL
# above) when a Redis connection succeeds at gateway startup, so multiple
# gateway replicas share one budget per key; it falls back to an in-memory,
# single-replica-only counter otherwise.

# ----------------------------------------------------------------------------
# Home Assistant Module (if MODULE_HOME_ASSISTANT=true)
# ----------------------------------------------------------------------------
# Credentials can be set here OR via admin backend (recommended for security)
# Leave blank if configuring via admin backend
HA_URL=
HA_TOKEN=
# WebSocket URL for HA realtime events (optional; derived from HA_URL if empty)
# HA_WS_URL=ws://homeassistant.local:8123/api/websocket

# Get a Long-Lived Access Token from Home Assistant:
# 1. Go to your Home Assistant profile
# 2. Scroll to "Long-Lived Access Tokens"
# 3. Click "Create Token"
# 4. Give it a name (e.g., "Project Athena")
# 5. Copy the token here

# Climate / Thermostat preferences (used by HA climate skill)
# CLIMATE_ENTITY=climate.thermostat
# DEFAULT_ROOM=guest
# MIN_TEMP=65
# MAX_TEMP=75
# CALENDAR_POLL_INTERVAL_SECONDS=600

# Kitchen appliance entities (jarvis-web /api/appliances/* endpoints). This
# names a specific appliance model's HA entities -- most deployments don't
# have these; each endpoint reports "not configured" (503) until its own
# entity ID(s) are set.
# OVEN_ENTITY_ID=water_heater.your_oven
# FRIDGE_ENTITY_ID=water_heater.your_fridge
# FREEZER_ENTITY_ID=water_heater.your_freezer
# STOVE_COOK_MODE_SENSOR_ID=sensor.stove_cook_mode
# STOVE_DISPLAY_TEMP_SENSOR_ID=sensor.stove_display_temperature
# STOVE_TIMER_SENSOR_ID=sensor.stove_cook_time_remaining
# FRIDGE_DOOR_SENSOR_ID=binary_sensor.refrigerator_door

# ----------------------------------------------------------------------------
# Voice Services (Wyoming Protocol)
# ----------------------------------------------------------------------------
