# ============================================================================
# RAG Services - API Keys
# ============================================================================
# Key source and precedence (ATHENA-88 / F91):
#   - Every key below can also be set via the admin UI's External API Keys
#     page (AdminConfigClient.get_external_api_key), which is backed by a
#     database table, not this file.
#   - At service startup, the ADMIN KEY STORE WINS: if the store returns a
#     key, it overwrites whatever is set here. A key set only here (with
#     nothing in the store) is used as-is; the store returning nothing
#     (404, non-2xx, or a connection error) falls back to this file.
#   - Changing a key in the admin UI takes effect on the RAG service's next
#     restart, not live — the store is only consulted at startup. Restart
#     the affected athena-rag-<service> pod after changing a key there.
#   - scripts/generate-rag-manifests.py's SERVICES table names exactly the
#     env var each service's own code reads; scripts/check-rag-key-env.py
#     enforces that in CI (rag-generator-drift.yml) so this file, the
#     generated Secret refs, and the code never drift apart again.

# ──────────────────────────────────────────────────────────────────────────
# Weather Service - Port 8010
# ──────────────────────────────────────────────────────────────────────────
# OpenWeatherMap API
# Free tier: 1,000 calls/day
# Sign up: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Sports Service - Port 8017
# ──────────────────────────────────────────────────────────────────────────
# TheSportsDB API
# Free tier available
# Sign up: https://www.thesportsdb.com/api.php
THESPORTSDB_API_KEY=
# Sports also reads GNEWS_API_KEY and API_FOOTBALL_KEY (both optional —
# see the "Additional / alternative search & data providers" section below).

# ──────────────────────────────────────────────────────────────────────────
# News Service - Port 8016
# ──────────────────────────────────────────────────────────────────────────
# News reads its key from the admin API key store only (store keys
# api-newsapiai / api-webz) — the service's own code has no
# os.getenv/os.environ read for a NewsAPI-style env var. Configure it via
# the admin UI's External API Keys page, not here.

# ──────────────────────────────────────────────────────────────────────────
# Events Service - Port 8014
# ──────────────────────────────────────────────────────────────────────────
# Ticketmaster Discovery API
# Free tier: 5,000 API calls/day
# Sign up: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
TICKETMASTER_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Stocks Service - Port 8012
# ──────────────────────────────────────────────────────────────────────────
# Alpha Vantage API
# Free tier: 5 API requests/minute, 500 requests/day
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Recipes Service - Port 8020
# ──────────────────────────────────────────────────────────────────────────
# Spoonacular Food API
# Free tier: 150 requests/day
# Sign up: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Dining Service - Port 8019
# ──────────────────────────────────────────────────────────────────────────
# Google Places API (also used by the Directions service below for place
# lookups — one key covers both).
# Sign up: https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Streaming Service - Port 8015
# ──────────────────────────────────────────────────────────────────────────
# The Movie Database (TMDB) API
# Free tier: 1 million requests/month
# Sign up: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Flights Service - Port 8013
# ──────────────────────────────────────────────────────────────────────────
# FlightAware AeroAPI (also read by the Airports service — one key covers
# both).
# Pricing varies - check https://www.flightaware.com/commercial/aeroapi/pricing/
# Sign up: https://www.flightaware.com/commercial/aeroapi/
FLIGHTAWARE_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# WebSearch Service - Port 8018
# ──────────────────────────────────────────────────────────────────────────
# Brave Search API - Universal fallback for unknown questions (also read by
# the Sitescraper service — one key covers both).
# Free tier: 2,000 queries/month
# Sign up: https://brave.com/search/api/
BRAVE_API_KEY=
# Some modules read the same key under this alias:
# BRAVE_SEARCH_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Additional / alternative search & data providers (Optional)
# ──────────────────────────────────────────────────────────────────────────
# SerpAPI — Google-results API. Reads SERPAPI_API_KEY only.
# Sign up: https://serpapi.com/
# SERPAPI_API_KEY=
# GNews — alternative to NewsAPI.  https://gnews.io/
# GNEWS_API_KEY=
# Eventbrite events.  https://www.eventbrite.com/platform/api
# EVENTBRITE_API_KEY=
# SeatGeek (events) — uses OAuth client credentials, not the bare API key.
# SEATGEEK_CLIENT_ID=
# SEATGEEK_CLIENT_SECRET=
# API-Football (sports).  https://www.api-football.com/
# API_FOOTBALL_KEY=
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Google Directions API (Places lookups reuse GOOGLE_PLACES_API_KEY above,
# already active in the Dining Service section).
# GOOGLE_DIRECTIONS_API_KEY=
# Bright Data (web scraping / unblocker).  https://brightdata.com/
# BRIGHT_DATA_API_TOKEN=
# BRIGHT_DATA_ZONE=web_unlocker1
# n8n workflow automation (self-hosted).
# N8N_URL=http://localhost:5678
# N8N_API_KEY=
# N8N_MCP_URL=
# Overseerr (media requests).
# OVERSEERR_URL=http://localhost:5055
# OVERSEERR_API_KEY=
# OpenAI (cloud LLM fallback).
# OPENAI_API_KEY=

