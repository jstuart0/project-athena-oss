# ============================================================================
# Admin Security (Optional - review for production)
# ============================================================================

# CORS allowed origins for the admin backend (comma-separated list)
# Default (dev): http://localhost:8080
# Production example: https://athena.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8080
# chat-embed reads its own CORS_ORIGINS (the sites that embed the chat):
# empty by default, and "*" and "null" are refused. See
# apps/chat-embed/.env.example.

# Twilio Auth Token for SMS webhook signature validation
# Required only if SMS/notifications features are enabled.
# Get from: Twilio console → Account Info → Auth Token
# Leave blank only for local development (DEV_MODE=true skips validation)
# or with TWILIO_ALLOW_UNSIGNED=true below; otherwise, blank, the SMS webhooks
# answer 503.
# requires TWILIO_WEBHOOK_BASE_URL
# set this in the environment; the Admin UI SMS "Auth Token" field is not
# persisted and doesn't enable validation (ATHENA-75)
TWILIO_AUTH_TOKEN=

# Twilio SMS webhook base URL. Required whenever TWILIO_AUTH_TOKEN is set.
# This is the public base Twilio calls: scheme + host [+ port] [+ a path
# prefix only if a proxy strips one]. Must be http or https, with a
# non-empty hostname, no user:pass@ userinfo, and (if given) a valid
# numeric port; no literal ? or # anywhere in the string. A trailing
# slash on the path is stripped. It must match the URL configured in the
# Twilio console exactly, including host case, without
# /api/sms/webhook/... and without any #... override fragment.
# Example: https://athena.example.com
# When unset or malformed with the token set, the webhooks answer 503 and
# admin-backend logs twilio_webhook_base_url_not_configured.
# TWILIO_WEBHOOK_BASE_URL=

# Accept Twilio webhooks WITHOUT a signature when TWILIO_AUTH_TOKEN is blank
# (outside DEV_MODE). Only the exact value "true" opts in. The sender is then
# unauthenticated: anyone who knows a guest's phone number can text the
# assistant as that guest and read its answers. Ignored when the token is set.
# admin-backend logs twilio_unsigned_webhooks_allowed (ERROR) at startup and
# twilio_unsigned_request_accepted (WARNING) per request.
# TWILIO_ALLOW_UNSIGNED=

# Country calling code (1-3 digits, no "+") added to a booking's national
# phone number when matching an incoming SMS to a stay. Only an exact E.164
# match counts. Default 1; an invalid value logs an ERROR and uses 1.
# SMS_DEFAULT_COUNTRY_CODE=1

# Twilio outbound SMS (Optional - only needed if sending SMS)
# Use API keys (TWILIO_API_KEY_SID/SECRET) instead of the master auth token
# when possible.  https://www.twilio.com/docs/iam/api-keys
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=

# Internal service-to-service auth key (admin ↔ orchestrator/gateway/RAG).
# Same value as SERVICE_API_KEY above; some clients read it as GATEWAY_API_KEY.
# GATEWAY_API_KEY=

# ============================================================================
# Authentication (Optional - for admin interface SSO)
# ============================================================================

# Authentik OIDC Configuration (if using Authentik SSO)
# AUTHENTIK_CLIENT_ID=
# AUTHENTIK_CLIENT_SECRET=
# AUTHENTIK_ISSUER_URL=https://auth.example.com/application/o/athena/

# Generic OIDC client (used by the admin backend when AUTHENTIK_* not set)
#
# SECURITY: The following values are REJECTED at startup and will cause SystemExit:
#   OIDC_CLIENT_ID=""          (empty)
#   OIDC_CLIENT_ID=demo-mode
#   OIDC_CLIENT_ID=CONFIGURE_ME_OIDC_CLIENT_ID
# Set OIDC_CLIENT_ID to your IdP's real client ID.
#
# OIDC_ISSUER must exactly match the `iss` claim in tokens issued by your IdP.
# The backend fetches <OIDC_ISSUER>/.well-known/openid-configuration at startup;
# an unreachable IdP will cause a fatal startup failure.
#
# OIDC_ISSUER=https://auth.example.com/application/o/athena-admin/
# OIDC_CLIENT_ID=your-real-client-id
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
# OIDC_SCOPES=openid profile email
# Optional override for the OIDC userinfo endpoint; derived from OIDC discovery
# metadata automatically when unset (falls back to OIDC_ISSUER + /userinfo/).
# OIDC_USERINFO_URL=

# ----------------------------------------------------------------------------
# Local-login brute-force defenses (ATHENA-14)
# ----------------------------------------------------------------------------
# Per-IP rate limit on POST /api/auth/local-login (Redis-backed via
# fastapi-limiter).  Custom identifier ignores X-Forwarded-For — keys by
# direct peer IP only.  Set to 0 to disable rate limiting (lockout + timing
# floor still defend).  Default: 5 per minute per IP.
# LOGIN_RATE_LIMIT_PER_MINUTE=5

# Per-username DB-tracked lockout.  Atomically increments
# users.failed_login_count on each wrong-password attempt; locks the account
# (sets users.locked_until) once the threshold is reached.  Lock is
# idempotent — past-threshold attempts don't extend the window.  Successful
# login resets the counter.  Default: 10 cumulative failures.
# LOGIN_LOCKOUT_THRESHOLD=10

# Lockout window in minutes.  Lock self-expires lazily on the next login
# attempt after the window passes.  Admins can clear locks early via
# psql: UPDATE users SET failed_login_count=0, locked_until=NULL WHERE username='<name>';
# Default: 30 minutes.
# LOGIN_LOCKOUT_MINUTES=30

# Wall-time floor on every failure path of POST /api/auth/local-login.
# All four failure branches (not-found, inactive, locked, wrong-password)
# pay full PBKDF2 cost via dummy-hash AND sleep until elapsed >= floor.
# Tuned to exceed PBKDF2-600k cost on slow hardware.  Default: 400ms.
# LOGIN_MINIMUM_DELAY_MS=400

# Rate limit for service-registry write endpoints (ATHENA-1 Phase 2).
# Covers POST/toggle/refresh/DELETE on /api/service-registry/services/*.
# Separate token bucket from LOGIN_RATE_LIMIT_PER_MINUTE so CA startup-upsert
# does not contend with login traffic.  Default 60 (accommodates CA's per-
# service upsert loop on startup without hitting the limit).
# SERVICE_REGISTRY_WRITE_PER_MINUTE=60

# Explicit endpoint_url override for a RAG service's own self-registration
# POST (shared/service_registry.py::register_service(), ATHENA-108).  Empty
# by default: the self-registration ping omits endpoint_url entirely, so it
# never overwrites a service-registry row's seeded host/port/protocol (the
# correct in-cluster K8s Service DNS name) with this process's own
# "http://localhost:<port>" view of itself.  Only set this for a deployment
# where the self-reported endpoint genuinely IS authoritative -- e.g. a
# bare-metal dev RAG service that was never seeded into the registry.
# SERVICE_REGISTRY_ENDPOINT_URL=

# Overrides the connector-name normalisation shared/service_registry.py::
# to_rag_registry_name()/to_rag_host_label() apply by default (lower-case,
# strip "-"/"_", then the "-rag"/"athena-rag-" convention) for a deployer
# whose seeded row doesn't follow that convention.  When set, it IS the base
# used to build both the registry `name` and `host_label` -- no further
# normalisation is applied.  Empty by default: derive the base from the
# connector's own service_name.
# SERVICE_REGISTRY_NAME=

# ============================================================================
# Feature Flags (Optional - toggle individual data sources)
# ============================================================================
# All default to true.  Set to "false" to disable that source.

# ENABLE_BRAVE_SEARCH=true
# ENABLE_DUCKDUCKGO=true
# ENABLE_EVENTBRITE=true
# ENABLE_SEARXNG=true
# ENABLE_TICKETMASTER=true

# ============================================================================
# TeslaMate Integration (Optional - read Tesla data from a TeslaMate DB)
# ============================================================================
# TESLAMATE_ENABLED defaults to false. The Tesla RAG service starts in
# degraded mode when disabled (/health Ready=1, /query and direct routes
# return HTTP 503 "Tesla integration not configured"). Set to true AND
# fill in the TESLAMATE_DB_* variables below to enable. (ATHENA-37)
# TESLAMATE_ENABLED=false
# TESLAMATE_DB_HOST=localhost
# TESLAMATE_DB_PORT=5432
# TESLAMATE_DB_NAME=teslamate
# TESLAMATE_DB_USER=teslamate
# TESLAMATE_DB_PASS=

# ============================================================================
# Region-configurable RAG services (transportation, community_events, amtrak)
# ============================================================================
# These services ship with NO region baked in. Unset means the service
# reports "not configured" via /health and its data routes return 503.

# TRANSIT_REGION_NAME: a display label only, purely cosmetic.
# TRANSIT_REGION_NAME=Denver Metro

# TRANSIT_GTFS_FEEDS: JSON object of {feed_id: {name, agency, url, type,
# free, description?, bounds?, max_bytes?, allow_private?}}.
# - bounds (optional): {min_lat, max_lat, min_lon, max_lon} drops any stop
#   outside the box (exclusive comparisons). Omit to keep every stop.
# - max_bytes (optional): per-feed download size cap in bytes. Default 100 MiB.
# - allow_private (optional, default false): permits this ONE feed's own
#   hostname to resolve to a private/internal address. Every other hop, and
#   every other feed, is still SSRF-guarded by default (no exceptions).
# TRANSIT_GTFS_FEEDS={"rtd_bus":{"name":"RTD Local Bus","agency":"rtd","url":"https://www.rtd-denver.com/files/gtfs/google_transit.zip","type":"bus","free":false,"bounds":{"min_lat":39.5,"max_lat":39.9,"min_lon":-105.3,"max_lon":-104.7}}}

# TRANSIT_STATIC_SERVICES: JSON object of non-GTFS transit services with
# fixed schedules (e.g. a seasonal ferry): {service_id: {name, type, free,
# hours: {weekday, weekend}, frequency_minutes, stops: [{name, lat, lon}],
# agency_name?, description?}}.
# TRANSIT_STATIC_SERVICES={"confluence_ferry":{"name":"Confluence Park Ferry","type":"ferry","free":true,"hours":{"weekday":{"start":"07:00","end":"19:00"},"weekend":null},"frequency_minutes":20,"stops":[{"name":"Confluence Park","lat":39.7527,"lon":-105.0089},{"name":"REI Denver","lat":39.7534,"lon":-105.0075}],"agency_name":"Denver Parks & Rec","description":"Free seasonal ferry along the South Platte River"}}

# COMMUNITY_EVENTS_SOURCES: JSON array of community-event sources. Each
# entry's `type` selects the parser: link_scan, event_cards,
# tribe_events_api, squarespace_eventlist. link_scan and event_cards are
# BEST-EFFORT HEURISTICS, validated only against their reference site's HTML
# structure at the time they were written -- a source's markup can drift
# without notice. tribe_events_api's is_free is always computed per-event
# from the API's own `cost` field (not independently configurable).
# COMMUNITY_EVENTS_SOURCES=[{"name":"Downtown Denver Partnership","type":"link_scan","url":"https://example.org/events-calendar","link_path":"/events-calendar/","base_url":"https://example.org","default_location":"Downtown Denver","default_address":"Downtown, Denver, CO","is_free":true,"category":"community","regions":["Downtown","LoDo"]},{"name":"Visit Denver Events API","type":"tribe_events_api","url":"https://example.org/wp-json/tribe/events/v1/events","default_location":"Denver","default_address":"Denver, CO","default_city":"Denver","default_state":"CO","category":"downtown","regions":["Downtown"]}]

# ============================================================================
# Home Assistant entity mappings (gateway/orchestrator/jarvis-web)
# ============================================================================
# All five of these ship with NO house-specific entity IDs baked in. Unset
# means the corresponding feature is disabled / falls back cleanly rather
# than guessing a device or room that doesn't exist in your HA instance.

# HA_SATELLITE_ROOM_MAP: JSON object mapping a Voice PE assist_satellite
# entity ID to the room it's physically in. Used by the gateway for BOTH
# directions: entity->room (detecting which room a conversation is coming
# from) and its inverse, room->entity (sending a satellite announcement to
# a specific room). For room detection, the map is checked first; a
# satellite not listed here still falls back to parsing "Voice - <Room>
# Assist" out of its HA friendly_name (the generic Voice PE convention),
# so this variable is an accuracy/override mechanism, not a hard
# requirement -- room detection works with zero configuration as long as
# your satellites follow that naming pattern. Satellite announcements
# (room->entity) DO require an entry here; unset means "no satellite
# mapping for room".
# HA_SATELLITE_ROOM_MAP={"assist_satellite.office_voice_pe":"office","assist_satellite.bedroom_voice_pe":"bedroom"}

# HA_LIGHT_GROUPS: JSON object mapping a room name to a light-group entity
# ID, used only by the orchestrator's scene-activation-failed fallback
# (dim/turn on that room's lights when a requested scene/script doesn't
# exist, e.g. "movie mode", "good morning"). Unset means a room with no
# configured group gets NO fallback at all -- never a house-wide "all"
# lights target.
# HA_LIGHT_GROUPS={"living_room":"light.living_room_all","office":"light.office_all"}

# HA_TV_ENTITIES: fallback room -> Apple TV entity mapping, used only when
# the admin API's Room TV Config is unreachable. Accepts a JSON array of
# {"room","media_player_entity_id","remote_entity_id"} objects, or a
# comma-separated list of "room:media_player_entity_id[:remote_entity_id]"
# triples for a lighter form.
# HA_TV_ENTITIES=[{"room":"living_room","media_player_entity_id":"media_player.living_room_tv","remote_entity_id":"remote.living_room_tv"}]

# HA_MUSIC_PLAYERS: fallback room -> Music Assistant media_player entity
# mapping, used only when the admin API's room_audio_config table is
# unreachable. Accepts a JSON object {"room":"entity_id"} or a
# comma-separated list of "room:entity_id" pairs.
# HA_MUSIC_PLAYERS={"living_room":"media_player.living_room","kitchen":"media_player.kitchen"}

# HA_BED_WARMER_ENTITIES: JSON object naming the 5 HA entities a
# Sunbeam-via-Tuya dual-zone bed-warmer/mattress-pad integration exposes.
# This is inherently specific hardware most deployments don't have; unset
# means the bed_warmer intent handler reports the feature isn't configured.
# HA_BED_WARMER_ENTITIES={"level_left":"select.bed_warmer_level_left","level_right":"select.bed_warmer_level_right","power_main":"switch.bed_warmer_power","power_side_a":"switch.bed_warmer_side_a","power_side_b":"switch.bed_warmer_side_b"}

# ============================================================================
# community_events Redis (DB isolation)
# ============================================================================
# community_events uses Redis DB 1 (other RAGs use DB 0). Set the full URL
# with the DB embedded in the path. Default in athena-config ConfigMap is
# redis://redis:6379/1. (ATHENA-34)
# COMMUNITY_EVENTS_REDIS_URL=redis://localhost:6379/1

# ============================================================================
# Development Settings
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Enable debug logging
DEBUG=true

# ============================================================================
# Container Registry (for Kubernetes deployments)
# ============================================================================
CONTAINER_REGISTRY=docker.io
CONTAINER_NAMESPACE=athena-voice

# ============================================================================
# Internal / Development Only
# ============================================================================
# These variables exist for development, debugging, and runtime tuning.
# A normal user should NOT need to set any of them — every var below has a
# sensible default in code.  Listed here so the env-example audit (issue #12)
# has something to point at, and so contributors can see what knobs exist.
#
# Boolean flags accept "true"/"false" (case-insensitive).
# ----------------------------------------------------------------------------

# Local-development convenience flags
# DEV_MODE=false                 # Bypasses OIDC gates; auto-creates dev-admin owner on unauthenticated requests.
#                                # NEVER enable in production.  If set true, DATABASE_URL must be SQLite
#                                # (or unset) — a non-SQLite DATABASE_URL with DEV_MODE=true causes a fatal
#                                # startup exit (xander:6, ATHENA-12).
# DEMO_MODE=false                # Pre-seeded demo data and demo-user auth bypass.
#                                # Requires DEV_MODE=true — rejected at startup if DEV_MODE=false (xander:16, ATHENA-12).
# LOCAL_DEV=false                # Set to "true" to use http://localhost:8080 as admin URL fallback when no ADMIN_API_URL is set. Local-dev escape hatch.

# Logging
# LOG_LEVEL=INFO                 # DEBUG / INFO / WARNING / ERROR
# LOG_FORMAT=json                # "json" or "text"
# SQL_ECHO=false                 # Echo SQL statements via SQLAlchemy.
# ATHENA_DEBUG_MODE=false        # Verbose tracing across orchestrator components.
# ATHENA_LOG_DIR=~/.../logs/debug
# ATHENA_DEBUG_LOG_DIR=~/.../logs/debug
# ATHENA_SERVICE_LOG_DIR=/tmp

# DB pool tuning (SQLAlchemy)
# DB_POOL_SIZE=10
# DB_POOL_MIN=1
# DB_POOL_MAX=5
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600
# DB_POOL_PRE_PING=true
# DB_STATEMENT_TIMEOUT_MS=2000

# Caching, rate-limiting, sessions
# FEATURE_CACHE_TTL=60           # Seconds; per-feature cache lifetime.
# RATE_LIMIT_RPM=30
# SEARCH_TIMEOUT=3.0             # Seconds for outbound search calls.
# SESSION_MAX_AGE=28800          # Seconds (8h).
# JWT_EXPIRATION=28800           # Seconds (8h).
# REDIS_DB=1
# REDIS_ENABLED=false

# Model-routing fallbacks (used when the primary model is unavailable).
# Most users want ATHENA_DEFAULT_MODEL in config.env.example instead — these
# are per-component overrides for power users / benchmarking.
# ATHENA_MODEL_CLASSIFIER=
# ATHENA_MODEL_SMALL=
# ATHENA_MODEL_MEDIUM=
# ATHENA_MODEL_LARGE=
# ATHENA_MODEL_SYNTHESIS=
# ATHENA_INTENT_DISCOVERY_MODEL=llama3.2:3b
# ATHENA_FALLBACK_MODEL_INTENT_CLASSIFIER=
# ATHENA_FALLBACK_MODEL_RESPONSE_SYNTHESIS=
# ATHENA_FALLBACK_MODEL_RESPONSE_SYNTHESIS_COMPLEX=
# ATHENA_FALLBACK_MODEL_TOOL_CALLING_SIMPLE=
# ATHENA_FALLBACK_MODEL_TOOL_CALLING_COMPLEX=
# ATHENA_FALLBACK_MODEL_TOOL_CALLING_SUPER_COMPLEX=
# ATHENA_FALLBACK_MODEL_FACT_CHECK_VALIDATION=
# ATHENA_FALLBACK_MODEL_CONVERSATION_SUMMARIZER=

# MLX (Apple Silicon) model overrides
# ATHENA_MLX_SMALL_MODEL=qwen3-4b-mlx
# ATHENA_MLX_LARGE_MODEL=qwen3-8b-mlx
# MLX_URL=

# Wake-word assets
# WAKE_WORD_MODEL_DIR=/models/wake_words

# OSS restart-hook behaviour ("manual" / "auto")
# ATHENA_OSS_RESTART_HOOK_MODE=manual

# Twilio testing
# TWILIO_TEST_MODE=false
# TWILIO_RATE_LIMIT=10

# Service-discovery overrides used inside Docker / K8s — only set if the
# defaults baked into config.py don't match your topology.
# RAG_HOST=http://localhost
# RAG_SERVICE_HOST=localhost
# RAG_SERVICE_NAME=
# REDIS_SERVICE_HOST=redis
# REDIS_SERVICE_PORT=6379
# SERVICE_PORT=                   # Per-service port; usually set by deployment.
# DIRECTIONS_PORT=8030
# PRICE_COMPARE_PORT=8033
# SERPAPI_EVENTS_PORT=8032
# SITE_SCRAPER_PORT=8031
# START_GATEWAY=true
# SOURCE_TAG=chatbot

# Homelab-specific (development only — IPs of the maintainer's machines)
# MAC_MINI_IP=localhost
# MAC_STUDIO_IP=localhost

# ============================================================================
# API Key Quick Reference
# ============================================================================
#
# All services offer free tiers suitable for personal/development use.
#
# **Recommended Order for Setup:**
# 1. OpenWeatherMap (weather) - Most commonly used
# 2. Brave Search (websearch) - CRITICAL fallback for unknown questions
# 3. NewsAPI (news) - Useful for daily briefings
# 4. TMDB (streaming) - Movie/TV recommendations
# 5. Spoonacular (recipes) - Cooking assistance
# 6. Yelp (dining) - Restaurant recommendations
# 7. Ticketmaster (events) - Event discovery
# 8. Alpha Vantage (stocks) - Financial data
# 9. FlightAware (flights) - Flight tracking (requires paid tier)
#
# **Free Tier Limits Summary:**
# - OpenWeatherMap: 1,000 calls/day
# - Brave Search: 2,000 queries/month
# - NewsAPI: 100 requests/day, 7 days history
# - Ticketmaster: 5,000 calls/day
# - Alpha Vantage: 5/min, 500/day
# - Spoonacular: 150/day
# - Yelp: 5,000/day
# - TMDB: 1 million/month
# - FlightAware: Paid tiers only
#
# **Rate Limiting Strategy:**
# - All services use Redis caching to minimize API calls
# - Cache TTLs configured per service (1min - 24hrs)
# - Consider upgrading to paid tiers for production use
#
# ============================================================================

# =============================================================================
# Install telemetry
# =============================================================================
# admin-backend sends a pseudonymous daily heartbeat (version, install shape,
# model families, local vs cloud, coarse usage buckets; never names, hosts,
# keys or queries). It's on by default. Either of these turns it off.
# See docs/CONFIGURATION.md "Telemetry".
# ATHENA_TELEMETRY=off
# DO_NOT_TRACK=1
# ATHENA_TELEMETRY_ENDPOINT sets where heartbeats go (an empty value also turns
# telemetry off); ATHENA_TELEMETRY_MODE overrides the detected install class.
