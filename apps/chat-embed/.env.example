# Required
ATHENA_CHAT_URL=http://your-jarvis-web/api/chat
ATHENA_ADMIN_URL=http://your-athena-admin

# Optional
# Must point at jarvis-web, not the orchestrator -- the orchestrator's
# /query/stream requires X-Service-Key (D10), which this proxy doesn't send.
STREAM_URL=http://your-jarvis-web:3001/api/chat/stream
CORS_ORIGINS=https://yoursite.com,https://www.yoursite.com
RATE_LIMIT_RPM=30
SOURCE_TAG=chatbot
