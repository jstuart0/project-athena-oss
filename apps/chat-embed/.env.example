# Required
ATHENA_CHAT_URL=http://your-jarvis-web/api/chat
# The same value as jarvis-web's JARVIS_RELAY_KEY (at least 32 random
# characters). Without it, or with a different value, every message fails.
JARVIS_RELAY_KEY=
ATHENA_ADMIN_URL=http://your-athena-admin

# Optional
# Must point at jarvis-web, not the orchestrator -- the orchestrator's
# /query/stream requires X-Service-Key (D10), which this proxy doesn't send.
# Use https, or an in-cluster (*.svc / *.cluster.local) or loopback address:
# the relay key rides on every request.
STREAM_URL=http://your-jarvis-web:3001/api/chat/stream
# The sites that embed the chat. Empty (the default) means no browser can
# call chat-embed; "*" and "null" are refused.
CORS_ORIGINS=https://yoursite.com,https://www.yoursite.com
# Messages per minute per visitor.
RATE_LIMIT_RPM=20
# The proxy in front of chat-embed, if any, whose X-Forwarded-For names the
# visitor. Without a usable visitor address chat-embed answers 503.
# TRUSTED_PROXY_CIDRS=
# "true" only behind a Cloudflare tunnel whose whole chain is in
# TRUSTED_PROXY_CIDRS (default off).
# TRUST_CF_CONNECTING_IP=false
SOURCE_TAG=chatbot
