# =============================================================================
# Project Athena Configuration
# =============================================================================
#
# Copy this file to config.env and fill in your values:
#   cp config.env.example config.env
#
# Then run the deployment:
#   ./scripts/deploy.sh
#
# =============================================================================

# =============================================================================
# Container Registry
# =============================================================================
# Where to push/pull container images
# Examples:
#   - Local registry:     localhost:5000
#   - Docker Hub:         docker.io/myusername
#   - GitHub Container:   ghcr.io/myorg
#   - Private registry:   registry.example.com:5000

REGISTRY=localhost:5000

# Image tag (default: latest)
TAG=latest

# Set to 1 if REGISTRY is a private plain-HTTP registry Docker hasn't
# already been configured to trust (e.g. via daemon.json's
# "insecure-registries"). build-and-push.sh's tag-collision guard uses
# `docker manifest inspect` to check whether TAG already exists before
# pushing; against an untrusted-HTTP registry that call fails closed
# (refuses the push) unless this is set, which appends --insecure to that
# one check only — it does NOT affect the actual `docker build`/`docker
# push` calls, which need their own Docker daemon configuration for an
# insecure registry regardless of this setting.
# REGISTRY_INSECURE=1

# =============================================================================
# Kubernetes
# =============================================================================
# Namespace for deployment
NAMESPACE=athena-prod

# =============================================================================
# Database Configuration (Required)
# =============================================================================
# PostgreSQL connection details

ATHENA_DB_HOST=localhost
ATHENA_DB_PORT=5432
ATHENA_DB_NAME=athena
ATHENA_DB_USER=athena
ATHENA_DB_PASSWORD=changeme

# =============================================================================
# Domain Configuration
# =============================================================================
# Your domain names for the services
# For local development, add these to /etc/hosts:
#   127.0.0.1 athena.local chat.local

ATHENA_DOMAIN=athena.local
CHAT_DOMAIN=chat.local

# =============================================================================
# LLM Backend (Optional)
# =============================================================================
# Default uses in-cluster Ollama. For external LLM:
#
# External Ollama:
#   OLLAMA_HOST=192.168.1.100
#
# MLX-LM on Apple Silicon:
#   OLLAMA_HOST=192.168.1.100
#   OLLAMA_PORT=8080
#   OLLAMA_PATH=/v1
#
# OpenAI API:
#   OLLAMA_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...

# OLLAMA_HOST=
# OLLAMA_PORT=11434

# =============================================================================
# LLM Model Configuration
# =============================================================================
# Default model for all components. On first startup, the application will:
#   1. Seed the database with LLM backend and component model assignments
#   2. Auto-pull the model from Ollama if not already available
#
# ATHENA_DEFAULT_MODEL controls which model is used for all orchestrator components.
# Recommended models (in order of quality vs speed tradeoff):
#   - qwen3:4b (default) - Best balance of speed and quality for most tasks
#   - phi3:mini          - Faster but less capable
#   - llama3.2:3b        - Good alternative to qwen3
#
# Set ATHENA_SEED_DEFAULTS=false to skip automatic database seeding
# Set ATHENA_AUTO_PULL_MODELS=false to skip automatic model downloading

ATHENA_DEFAULT_MODEL=qwen3:4b
ATHENA_SEED_DEFAULTS=true
ATHENA_AUTO_PULL_MODELS=true

# =============================================================================
# Home Assistant Integration (Optional)
# =============================================================================
# URL and long-lived access token for Home Assistant

HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# =============================================================================
# API Keys (Optional)
# =============================================================================
# These enable various RAG services. Leave empty to disable.

# Weather
OPENWEATHER_API_KEY=

# Search
BRAVE_API_KEY=
SERPAPI_API_KEY=

# News & Media (News is key-store only -- its own code reads no env var;
# configure via the admin UI's External API Keys page)
TMDB_API_KEY=

# Events & Entertainment
TICKETMASTER_API_KEY=
# SeatGeek uses OAuth client credentials, not a bare API key.
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# Finance
ALPHA_VANTAGE_API_KEY=

# Food & Dining (also used by Directions for place lookups)
GOOGLE_PLACES_API_KEY=
SPOONACULAR_API_KEY=

# Sports
THESPORTSDB_API_KEY=

# Travel (FLIGHTAWARE_API_KEY also used by Airports)
FLIGHTAWARE_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=

# Vehicles -- Tesla reads TeslaMate DB connection vars, not an API-key
# credential; nothing to set here.

# Web Scraping
BRIGHT_DATA_API_TOKEN=

# =============================================================================
# Encryption Keys (Auto-generated if not provided)
# =============================================================================
# These will be auto-generated on first run if not set.
# Save them somewhere secure if you need to recreate secrets.

# ENCRYPTION_KEY=
# ENCRYPTION_SALT=
# SESSION_SECRET_KEY=
# JWT_SECRET=

# =============================================================================
# Install telemetry
# =============================================================================
# admin-backend sends a pseudonymous daily heartbeat (version, install shape,
# model families, local vs cloud, coarse usage buckets; never names, hosts,
# keys or queries). It's on by default. Either of these turns it off.
# See docs/CONFIGURATION.md "Telemetry".
# ATHENA_TELEMETRY=off
# DO_NOT_TRACK=1
# ATHENA_TELEMETRY_ENDPOINT sets where heartbeats go (an empty value also turns
# telemetry off); ATHENA_TELEMETRY_MODE overrides the detected install class.
